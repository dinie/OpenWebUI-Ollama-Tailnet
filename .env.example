# Copy to .env (gitignored) — sourced by deploy.sh

# Required: reusable Tailscale auth key
# https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTHKEY=tskey-auth-XXXX

# Optional: generated automatically by deploy.sh if unset
# WEBUI_SECRET_KEY=

# Optional
# OPENAI_API_KEY=sk-...

# Optional deploy overrides (defaults come from fly.toml)
# FLY_APP=openwebui
# FLY_REGION=syd

# Render API (only needed for deploy-render.sh)
# RENDER_API_KEY=rnd_XXXX
# RENDER_SERVICE_ID=srv-XXXX
